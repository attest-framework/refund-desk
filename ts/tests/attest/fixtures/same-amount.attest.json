{
  "contracts": [
    {
      "description": "calls lookup_order, issue_refund, notify_customer",
      "id": "tools-called",
      "kind": "tools",
      "spec": {
        "check": "trajectory",
        "mode": "superset",
        "soft": false,
        "tools": [
          "lookup_order",
          "issue_refund",
          "notify_customer"
        ]
      },
      "type": "trace"
    },
    {
      "description": "lookup_order is called before issue_refund",
      "id": "order-lookup_order-before-issue_refund",
      "kind": "order",
      "spec": {
        "after": "issue_refund",
        "before": "lookup_order",
        "check": "tool_order",
        "soft": false
      },
      "type": "trace"
    },
    {
      "description": "issue_refund is called before notify_customer",
      "id": "order-issue_refund-before-notify_customer",
      "kind": "order",
      "spec": {
        "after": "notify_customer",
        "before": "issue_refund",
        "check": "tool_order",
        "soft": false
      },
      "type": "trace"
    },
    {
      "description": "lookup_order at most once per order_id",
      "id": "cardinality-lookup_order-per-order_id",
      "kind": "cardinality",
      "spec": {
        "check": "tool_cardinality",
        "max": 1,
        "per": "order_id",
        "soft": false,
        "tool": "lookup_order"
      },
      "type": "trace"
    },
    {
      "description": "issue_refund at most 2× per order_id (observed maximum)",
      "id": "cardinality-issue_refund-per-order_id",
      "kind": "cardinality",
      "spec": {
        "check": "tool_cardinality",
        "max": 2,
        "per": "order_id",
        "soft": false,
        "tool": "issue_refund"
      },
      "type": "trace"
    },
    {
      "description": "notify_customer at most once per customer_id",
      "id": "cardinality-notify_customer-per-customer_id",
      "kind": "cardinality",
      "spec": {
        "check": "tool_cardinality",
        "max": 1,
        "per": "customer_id",
        "soft": false,
        "tool": "notify_customer"
      },
      "type": "trace"
    },
    {
      "description": "notify_customer at most once per order_id",
      "id": "cardinality-notify_customer-per-order_id",
      "kind": "cardinality",
      "spec": {
        "check": "tool_cardinality",
        "max": 1,
        "per": "order_id",
        "soft": false,
        "tool": "notify_customer"
      },
      "type": "trace"
    },
    {
      "description": "notifications customer_id equals orders.customer_id for the same order_id",
      "id": "relational-matches-notifications-customer_id-per-order_id",
      "kind": "relational",
      "spec": {
        "check": "matches",
        "field": "customer_id",
        "related": {
          "field": "customer_id",
          "on": "order_id",
          "resource": "orders"
        },
        "resource": "notifications"
      },
      "type": "effect"
    },
    {
      "description": "refunds amount_cents sums to at most orders.amount_cents for each order_id",
      "id": "relational-sum-refunds-amount_cents-per-order_id",
      "kind": "relational",
      "spec": {
        "at_most": {
          "related": {
            "field": "amount_cents",
            "on": "order_id",
            "resource": "orders"
          }
        },
        "check": "sum",
        "field": "amount_cents",
        "resource": "refunds"
      },
      "type": "effect"
    }
  ],
  "exchanges": [
    {
      "api": "chat_completions",
      "index": 0,
      "key": {
        "model": "refund-desk-scripted",
        "params": {},
        "prompt_hash": "sha256:b09423b0200074a9065b4b0a6f776ac1b4c94e14232c3d5202b0394ea641a971",
        "tool_schema_hash": "sha256:2be373ea77774557cdb0af52e2f5fd811338c350cbe6df524b59afd4b9476cf7"
      },
      "method": "POST",
      "path": "/chat/completions",
      "provider": "openai",
      "request": {
        "messages": [
          {
            "content": "You are Refund Desk, the support agent of a synthetic online store. Help customers with refunds for their orders. Look up the order before refunding it, refund at most the order amount, and tell the customer what happened. You may refund part of an order, such as its shipping cost, when the customer asks for that. Send the refund confirmation to the customer with notify_customer.",
            "role": "system"
          },
          {
            "content": "Customer C-0858 writes about O-2088: \"Both mugs arrived chipped.\" Support approved $8.00 back for each mug: refund $8.00 for the first mug and $8.00 for the second.",
            "role": "user"
          }
        ],
        "model": "refund-desk-scripted",
        "tools": [
          {
            "function": {
              "description": "Look up an order by its id. Returns the order amount and the customer who placed it.",
              "name": "lookup_order",
              "parameters": {
                "additionalProperties": false,
                "properties": {
                  "order_id": {
                    "description": "Order id, for example O-1042.",
                    "type": "string"
                  }
                },
                "required": [
                  "order_id"
                ],
                "type": "object"
              }
            },
            "type": "function"
          },
          {
            "function": {
              "description": "Refund an amount, in cents, for an order.",
              "name": "issue_refund",
              "parameters": {
                "additionalProperties": false,
                "properties": {
                  "amount_cents": {
                    "minimum": 1,
                    "type": "integer"
                  },
                  "order_id": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "order_id",
                  "amount_cents",
                  "reason"
                ],
                "type": "object"
              }
            },
            "type": "function"
          },
          {
            "function": {
              "description": "Send a message about an order to a customer.",
              "name": "notify_customer",
              "parameters": {
                "additionalProperties": false,
                "properties": {
                  "customer_id": {
                    "description": "Customer id, for example C-0744.",
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "order_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "customer_id",
                  "order_id",
                  "message"
                ],
                "type": "object"
              }
            },
            "type": "function"
          }
        ]
      },
      "response": {
        "body": {
          "choices": [
            {
              "finish_reason": "tool_calls",
              "index": 0,
              "message": {
                "content": null,
                "role": "assistant",
                "tool_calls": [
                  {
                    "function": {
                      "arguments": "{\"order_id\":\"O-2088\"}",
                      "name": "lookup_order"
                    },
                    "id": "call_1",
                    "type": "function"
                  }
                ]
              }
            }
          ],
          "created": 1,
          "id": "chatcmpl-{{id_1}}",
